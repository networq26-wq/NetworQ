# Supabase
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Groq AI (server-side only)
GROQ_API_KEY=

# Email — Resend (free at resend.com)
RESEND_API_KEY=
RESEND_FROM_EMAIL="NetworQ <noreply@networq.co.in>"

# Google OAuth
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Allowed CORS Origins (comma-separated)
ALLOWED_ORIGIN=http://localhost:8081,http://localhost:3000,http://localhost:3001

# Production Backend URL (set after Fly.io deploy)
# EXPO_PUBLIC_AI_PROXY_URL=https://networq-app.fly.dev/api/ai
# EXPO_PUBLIC_EMAIL_PROXY_URL=https://networq-app.fly.dev/api/email

# One-click email links (generate: openssl rand -hex 32)
LINK_SIGNING_SECRET=
PUBLIC_APP_URL=https://www.networq.co.in

# Natural AI voice (optional): ElevenLabs. Falls back to Groq voice when unset.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
