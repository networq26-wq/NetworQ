{
  "name": "networq",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "node server.js",
    "build": "expo export --platform web && mkdir -p dist/illustrations && cp -r public/illustrations/* dist/illustrations/ && cp public/waitlist.html dist/waitlist.html",
    "dev": "./start.sh",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "serve": "node server.js",
    "host": "npm run build && node server.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "build:apk": "npx eas-cli@latest build --profile preview --platform android",
    "update": "npx eas-cli@latest update --auto",
    "test": "node --test api/_lib/*.test.js"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@supabase/supabase-js": "^2.105.4",
    "cors": "^2.8.6",
    "expo": "~55.0.8",
    "expo-dev-client": "^57.0.16",
    "expo-status-bar": "~55.0.4",
    "expo-updates": "^57.0.19",
    "express": "^5.2.1",
    "jsqr": "^1.4.0",
    "nodemailer": "^10.0.12",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.2",
    "react-native-web": "^0.21.0",
    "react-native-webview": "^14.0.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~5.9.2"
  },
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  }
}
