{
  "name": "networq",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "node server.js",
    "build": "expo export --platform web && mkdir -p dist/illustrations && cp -r public/illustrations/* dist/illustrations/ && cp public/waitlist.html dist/waitlist.html",
    "dev": "./start.sh",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "serve": "node server.js",
    "host": "npm run build && node server.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "build:apk": "npx eas-cli@latest build --profile preview --platform android",
    "update": "npx eas-cli@latest update --auto",
    "test": "node --test api/_lib/*.test.js tests/api/*.test.js tests/db/*.test.mjs",
    "test:rls": "QA_LIVE_SUPABASE=1 node --test tests/integration/*.test.js",
    "test:e2e": "playwright test",
    "test:all": "npx tsc --noEmit && npm test && npm run build && playwright test",
    "setup:supabase": "node scripts/setup-supabase.mjs",
    "preview": "./scripts/dev-preview.sh"
  },
  "dependencies": {
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@supabase/supabase-js": "^2.105.4",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "expo": "~55.0.8",
    "expo-constants": "~55.0.17",
    "expo-crypto": "~55.0.19",
    "expo-dev-client": "~55.0.40",
    "expo-notifications": "~55.0.27",
    "expo-status-bar": "~55.0.6",
    "expo-updates": "~55.0.33",
    "expo-web-browser": "~55.0.20",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsqr": "^1.4.0",
    "node-ical": "^0.27.2",
    "nodemailer": "^10.0.12",
    "qrcode": "^1.5.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.61.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.2.2",
    "typescript": "~5.9.2"
  },
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  }
}
